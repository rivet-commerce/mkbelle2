{% doc %}
  @prompt
    Erstelle eine Custom Section („Vergleichstabelle / Das spricht für uns“):
    
    Structure & Content:
    Überschrift: „Das spricht für uns“ (mittig zentriert, fett)
    Spalten-Header:
    Links: „MK Beauty Cosmetics“ (fett)
    Mitte: „VS“ (dezent / grau)
    Rechts: „ANDERE“ (fett)
    Tabellenzeilen (Features):
    Hautvorteile
    Natürliche Inhaltsstoffe
    Dermatologisch getestet
    Nachhaltige Verpackung
    Icon-Layout (WICHTIG):
    Das Icon (Häkchen ✓ bzw. Kreuz ✕) und der Text in der linken/rechten Spalte müssen in einer Reihe (nebeneinander / inline) platziert sein – nicht untereinander.
    Linke Spalte (MK Beauty Cosmetics): Grünes oder neutrales Häkchen-Icon ✓ direkt links vor dem Feature-Text.
    Rechte Spalte (ANDERE): Rotes oder dunkles Kreuz-Icon ✕ direkt rechts nach dem Feature-Text (oder vor dem Text).
    Mobile & Responsiv-Optimierung:
    Die Section muss vollständig mobil-optimiert sein.
    Auf Mobilgeräten soll die Tabelle übersichtlich und gut lesbar bleiben (kein überlappender Text, Icon und Text bleiben sauber inline auf einer Zeile).
    Nutze dezent horizontale Trennlinien zwischen den Zeilen., Kreuz-Icon & checkmars sollen in einer Linie sein , die icons und text sollen alle in einer spalte sein  bzw alle untereinander in einer reihe, unterschiedliche texte für mk Beauty cosmectis & andere , doch nur ein text der in der Mitte der Tabelle steht 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-comparison-table-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
    display: block;
  }

  .ai-comparison-table__heading-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    color: {{ block.settings.heading_color }};
  }

  .ai-comparison-table__wrapper-{{ ai_gen_id }} {
    max-width: {{ block.settings.table_max_width }}px;
    margin: 0 auto;
  }

  .ai-comparison-table__header-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: {{ block.settings.column_gap }}px;
    padding: {{ block.settings.row_padding }}px 0;
    border-bottom: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    margin-bottom: {{ block.settings.row_spacing }}px;
  }

  .ai-comparison-table__header-left-{{ ai_gen_id }} {
    text-align: center;
    font-weight: 700;
    font-size: {{ block.settings.header_font_size }}px;
    color: {{ block.settings.brand_color }};
  }

  .ai-comparison-table__header-vs-{{ ai_gen_id }} {
    text-align: center;
    font-weight: 400;
    font-size: {{ block.settings.vs_font_size }}px;
    color: {{ block.settings.vs_color }};
    padding: 0 {{ block.settings.vs_padding }}px;
  }

  .ai-comparison-table__header-right-{{ ai_gen_id }} {
    text-align: center;
    font-weight: 700;
    font-size: {{ block.settings.header_font_size }}px;
    color: {{ block.settings.competitor_color }};
  }

  .ai-comparison-table__row-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: {{ block.settings.column_gap }}px;
    padding: {{ block.settings.row_padding }}px 0;
    border-bottom: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    align-items: center;
  }

  .ai-comparison-table__row-{{ ai_gen_id }}:last-child {
    border-bottom: none;
  }

  .ai-comparison-table__cell-left-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: {{ block.settings.icon_text_gap }}px;
    font-size: {{ block.settings.feature_font_size }}px;
    color: {{ block.settings.text_color }};
  }

  .ai-comparison-table__cell-center-{{ ai_gen_id }} {
    width: {{ block.settings.vs_column_width }}px;
    flex-shrink: 0;
    text-align: center;
    font-size: {{ block.settings.feature_font_size }}px;
    color: {{ block.settings.text_color }};
  }

  .ai-comparison-table__cell-right-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: {{ block.settings.icon_text_gap }}px;
    font-size: {{ block.settings.feature_font_size }}px;
    color: {{ block.settings.text_color }};
  }

  .ai-comparison-table__icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
    display: block;
  }

  .ai-comparison-table__icon-check-{{ ai_gen_id }} {
    color: {{ block.settings.check_color }};
  }

  .ai-comparison-table__icon-cross-{{ ai_gen_id }} {
    color: {{ block.settings.cross_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-comparison-table-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.7 }}px 15px;
    }

    .ai-comparison-table__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
      margin-bottom: {{ block.settings.heading_spacing | times: 0.8 }}px;
    }

    .ai-comparison-table__header-{{ ai_gen_id }},
    .ai-comparison-table__row-{{ ai_gen_id }} {
      gap: {{ block.settings.column_gap | times: 0.6 }}px;
      padding: {{ block.settings.row_padding | times: 0.8 }}px 0;
    }

    .ai-comparison-table__header-left-{{ ai_gen_id }},
    .ai-comparison-table__header-right-{{ ai_gen_id }} {
      font-size: {{ block.settings.header_font_size | times: 0.85 }}px;
    }

    .ai-comparison-table__header-vs-{{ ai_gen_id }} {
      font-size: {{ block.settings.vs_font_size | times: 0.85 }}px;
      padding: 0 {{ block.settings.vs_padding | times: 0.6 }}px;
    }

    .ai-comparison-table__cell-left-{{ ai_gen_id }},
    .ai-comparison-table__cell-right-{{ ai_gen_id }},
    .ai-comparison-table__cell-center-{{ ai_gen_id }} {
      gap: {{ block.settings.icon_text_gap | times: 0.7 }}px;
      font-size: {{ block.settings.feature_font_size | times: 0.9 }}px;
    }

    .ai-comparison-table__icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.85 }}px;
      height: {{ block.settings.icon_size | times: 0.85 }}px;
    }

    .ai-comparison-table__cell-center-{{ ai_gen_id }} {
      width: {{ block.settings.vs_column_width | times: 0.7 }}px;
    }
  }
{% endstyle %}

<div class="ai-comparison-table-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-comparison-table__wrapper-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-comparison-table__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-comparison-table__header-{{ ai_gen_id }}">
      <div class="ai-comparison-table__header-left-{{ ai_gen_id }}">
        {{ block.settings.brand_name }}
      </div>
      <div class="ai-comparison-table__header-vs-{{ ai_gen_id }}">
        {{ block.settings.vs_text }}
      </div>
      <div class="ai-comparison-table__header-right-{{ ai_gen_id }}">
        {{ block.settings.competitor_name }}
      </div>
    </div>

    {% if block.settings.feature_1 != blank %}
      <div class="ai-comparison-table__row-{{ ai_gen_id }}">
        <div class="ai-comparison-table__cell-left-{{ ai_gen_id }}">
          <svg class="ai-comparison-table__icon-{{ ai_gen_id }} ai-comparison-table__icon-check-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </div>
        <div class="ai-comparison-table__cell-center-{{ ai_gen_id }}">
          {{ block.settings.feature_1 }}
        </div>
        <div class="ai-comparison-table__cell-right-{{ ai_gen_id }}">
          <svg class="ai-comparison-table__icon-{{ ai_gen_id }} ai-comparison-table__icon-cross-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </div>
      </div>
    {% endif %}

    {% if block.settings.feature_2 != blank %}
      <div class="ai-comparison-table__row-{{ ai_gen_id }}">
        <div class="ai-comparison-table__cell-left-{{ ai_gen_id }}">
          <svg class="ai-comparison-table__icon-{{ ai_gen_id }} ai-comparison-table__icon-check-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </div>
        <div class="ai-comparison-table__cell-center-{{ ai_gen_id }}">
          {{ block.settings.feature_2 }}
        </div>
        <div class="ai-comparison-table__cell-right-{{ ai_gen_id }}">
          <svg class="ai-comparison-table__icon-{{ ai_gen_id }} ai-comparison-table__icon-cross-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </div>
      </div>
    {% endif %}

    {% if block.settings.feature_3 != blank %}
      <div class="ai-comparison-table__row-{{ ai_gen_id }}">
        <div class="ai-comparison-table__cell-left-{{ ai_gen_id }}">
          <svg class="ai-comparison-table__icon-{{ ai_gen_id }} ai-comparison-table__icon-check-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </div>
        <div class="ai-comparison-table__cell-center-{{ ai_gen_id }}">
          {{ block.settings.feature_3 }}
        </div>
        <div class="ai-comparison-table__cell-right-{{ ai_gen_id }}">
          <svg class="ai-comparison-table__icon-{{ ai_gen_id }} ai-comparison-table__icon-cross-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </div>
      </div>
    {% endif %}

    {% if block.settings.feature_4 != blank %}
      <div class="ai-comparison-table__row-{{ ai_gen_id }}">
        <div class="ai-comparison-table__cell-left-{{ ai_gen_id }}">
          <svg class="ai-comparison-table__icon-{{ ai_gen_id }} ai-comparison-table__icon-check-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </div>
        <div class="ai-comparison-table__cell-center-{{ ai_gen_id }}">
          {{ block.settings.feature_4 }}
        </div>
        <div class="ai-comparison-table__cell-right-{{ ai_gen_id }}">
          <svg class="ai-comparison-table__icon-{{ ai_gen_id }} ai-comparison-table__icon-cross-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </div>
      </div>
    {% endif %}
  </div>
</div>

