{% doc %}
  @prompt
    iese Sektion ist als minimalistisches, dreispaltiges Grid-Layout aufgebaut, das speziell darauf ausgelegt ist, Kundenprobleme anzusprechen. Sie beginnt mit der zentrierten, eleganten Überschrift „Kennst du das?“, gefolgt von drei Spalten, die jeweils ein feines, hellblaues Linien-Icon über einem fettgedruckten Problem-Titel und einer kurzen, erklärenden Beschreibung zeigen. Um die Sektion abzurunden und die Lösung direkt zu präsentieren, platziert ein Shopify-Pagebuilder wie PageFly oder Shogun den konkreten Glastiegel der „MK BEAUTY COSMETICS - STEM CELLS MASK“ mittig darunter auf einer weichen, hellblauen Fläche, umgeben von einem reinen, weißen Hintergrund., Product image brauche ich nicht 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-problem-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 20px;
  }

  .ai-problem-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    width: 100%;
  }

  .ai-problem-heading-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px 0;
    font-weight: 400;
    letter-spacing: 0.5px;
  }

  .ai-problem-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.column_gap }}px;
  }

  .ai-problem-column-{{ ai_gen_id }} {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ai-problem-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin-bottom: {{ block.settings.icon_spacing }}px;
    color: {{ block.settings.icon_color }};
  }

  .ai-problem-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ai-problem-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px 0;
  }

  .ai-problem-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.6;
    margin: 0;
  }

  @media screen and (max-width: 768px) {
    .ai-problem-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.column_gap | times: 1.5 }}px;
    }

    .ai-problem-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<problem-section-{{ ai_gen_id }} class="ai-problem-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-problem-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-problem-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-problem-grid-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign title_key = 'problem_' | append: i | append: '_title'
          assign description_key = 'problem_' | append: i | append: '_description'
          assign icon_key = 'problem_' | append: i | append: '_icon'
          
          assign title = block.settings[title_key]
          assign description = block.settings[description_key]
          assign icon = block.settings[icon_key]
        %}

        <div class="ai-problem-column-{{ ai_gen_id }}">
          <div class="ai-problem-icon-{{ ai_gen_id }}">
            {% case icon %}
              {% when 'wrinkles' %}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/>
                  <path d="M8 9c0-.55.45-1 1-1s1 .45 1 1-.45 1-1 1-1-.45-1-1z"/>
                  <path d="M14 9c0-.55.45-1 1-1s1 .45 1 1-.45 1-1 1-1-.45-1-1z"/>
                  <path d="M7 14c.5 1.5 2 3 5 3s4.5-1.5 5-3"/>
                  <path d="M4 12h2M18 12h2M6 6l1.5 1.5M16.5 7.5L18 6M6 18l1.5-1.5M16.5 16.5L18 18"/>
                </svg>
              {% when 'dryness' %}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/>
                  <path d="M12 16v-4M10 14h4"/>
                </svg>
              {% when 'sensitivity' %}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                  <path d="M12 8v8M8 12h8"/>
                </svg>
              {% when 'aging' %}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <circle cx="12" cy="12" r="10"/>
                  <path d="M12 6v6l4 2"/>
                  <path d="M16 16c-1.5 1-3 1.5-4 1.5s-2.5-.5-4-1.5"/>
                </svg>
              {% when 'pigmentation' %}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <circle cx="12" cy="12" r="10"/>
                  <circle cx="9" cy="10" r="1.5"/>
                  <circle cx="15" cy="10" r="1.5"/>
                  <circle cx="12" cy="15" r="2"/>
                  <circle cx="8" cy="14" r="1"/>
                  <circle cx="16" cy="14" r="1"/>
                </svg>
              {% when 'dullness' %}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <circle cx="12" cy="12" r="5"/>
                  <line x1="12" y1="1" x2="12" y2="3"/>
                  <line x1="12" y1="21" x2="12" y2="23"/>
                  <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
                  <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
                  <line x1="1" y1="12" x2="3" y2="12"/>
                  <line x1="21" y1="12" x2="23" y2="12"/>
                  <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
                  <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
                </svg>
              {% else %}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <circle cx="12" cy="12" r="10"/>
                  <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
                  <line x1="12" y1="17" x2="12.01" y2="17"/>
                </svg>
            {% endcase %}
          </div>

          {% if title != blank %}
            <h3 class="ai-problem-title-{{ ai_gen_id }}">{{ title }}</h3>
          {% endif %}

          {% if description != blank %}
            <p class="ai-problem-description-{{ ai_gen_id }}">{{ description }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</problem-section-{{ ai_gen_id }}>

<script>
  (function() {
    class ProblemSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('problem-section-{{ ai_gen_id }}', ProblemSection{{ ai_gen_id }});
  })();
</script>

