{% doc %}
  @prompt
    Layout: Minimalistisches, zweispaltiges Split-Layout (ca. 50/50) auf rein weißem Hintergrund.
    Linke Spalte: Vertikal angeordnet eine Sterne-Bewertung ganz oben, gefolgt von einer großen, fetten Überschrift und drei Bullet-Points mit hellblauen Häkchen. Links daneben sitzt ein vertikales, gelbes Rabatt-Badge, und unten schließt ein auffälliger, gelber CTA-Button („Kategorie Entdecken“) ab.
    Rechte Spalte: Hier wird ein großes, freigestelltes Kategoriebild integriert (wird separat geliefert).
    Mobil: Das Layout bricht responsiv in eine einspaltige Ansicht um (Text oben, Bild unten)., nicht ganz das bild soll über die ganze breite und in dem bild der text & Button , text & button kleiner , Sterne text und Button ein bisschen weiter hoch in die linke Ecke dann passt , das Rabatt-Bage ragt über die Checkmarks kannst das Rabatt bar bisschen weiter hoch in die linke ecke schieben ? 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-split-layout-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    background-color: #ffffff;
  }

  .ai-split-layout__container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    min-height: {{ block.settings.min_height }}px;
    display: flex;
    align-items: flex-start;
  }

  .ai-split-layout__image-wrapper-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .ai-split-layout__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-split-layout__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-split-layout__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-split-layout__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 4px;
  }

  .ai-split-layout__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 2;
  }

  .ai-split-layout__content-wrapper-{{ ai_gen_id }} {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px {{ block.settings.horizontal_padding }}px;
  }

  .ai-split-layout__content-{{ ai_gen_id }} {
    position: relative;
    max-width: {{ block.settings.content_max_width }}px;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_spacing }}px;
    margin-right: auto;
    padding-left: {{ block.settings.badge_offset }}px;
  }

  .ai-split-layout__badge-wrapper-{{ ai_gen_id }} {
    position: absolute;
    left: 0;
    top: {{ block.settings.badge_vertical_position }}px;
    z-index: 2;
  }

  .ai-split-layout__badge-{{ ai_gen_id }} {
    background-color: {{ block.settings.badge_color }};
    color: {{ block.settings.badge_text_color }};
    padding: {{ block.settings.badge_padding_vertical }}px {{ block.settings.badge_padding_horizontal }}px;
    border-radius: {{ block.settings.badge_border_radius }}px;
    font-size: {{ block.settings.badge_font_size }}px;
    font-weight: 700;
    text-align: center;
    writing-mode: vertical-rl;
    text-orientation: mixed;
    transform: rotate(180deg);
    white-space: nowrap;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .ai-split-layout__rating-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .ai-split-layout__star-{{ ai_gen_id }} {
    width: {{ block.settings.star_size }}px;
    height: {{ block.settings.star_size }}px;
    fill: {{ block.settings.star_color }};
  }

  .ai-split-layout__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    line-height: 1.2;
    color: {{ block.settings.heading_color }};
    margin: 0;
  }

  .ai-split-layout__bullets-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.bullet_spacing }}px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ai-split-layout__bullet-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: {{ block.settings.bullet_font_size }}px;
    color: {{ block.settings.text_color }};
  }

  .ai-split-layout__checkmark-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.checkmark_size }}px;
    height: {{ block.settings.checkmark_size }}px;
    background-color: {{ block.settings.checkmark_color }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-split-layout__checkmark-icon-{{ ai_gen_id }} {
    width: calc({{ block.settings.checkmark_size }}px * 0.6);
    height: calc({{ block.settings.checkmark_size }}px * 0.6);
    stroke: #ffffff;
    stroke-width: 3;
  }

  .ai-split-layout__cta-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
  }

  .ai-split-layout__cta-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-split-layout__container-{{ ai_gen_id }} {
      min-height: {{ block.settings.mobile_min_height }}px;
    }

    .ai-split-layout__content-{{ ai_gen_id }} {
      max-width: 100%;
      padding-left: 0;
    }

    .ai-split-layout__badge-wrapper-{{ ai_gen_id }} {
      position: static;
      align-self: flex-start;
    }

    .ai-split-layout__badge-{{ ai_gen_id }} {
      writing-mode: horizontal-tb;
      transform: none;
    }

    .ai-split-layout__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.7);
    }

    .ai-split-layout__bullet-item-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.bullet_font_size }}px * 0.9);
    }

    .ai-split-layout__cta-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.button_font_size }}px * 0.9);
    }
  }
{% endstyle %}

<div class="ai-split-layout-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-split-layout__container-{{ ai_gen_id }}">
    <div class="ai-split-layout__image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.category_image %}
        <img
          src="{{ block.settings.category_image | image_url: width: 2000 }}"
          alt="{{ block.settings.category_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.category_image.width }}"
          height="{{ block.settings.category_image.height }}"
          class="ai-split-layout__image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-split-layout__image-placeholder-{{ ai_gen_id }}">
          {{ 'product-1' | placeholder_svg_tag }}
          <div class="ai-split-layout__empty-state-{{ ai_gen_id }}">
            Kategoriebild hinzufügen
          </div>
        </div>
      {% endif %}
    </div>

    {% if block.settings.show_overlay %}
      <div class="ai-split-layout__overlay-{{ ai_gen_id }}"></div>
    {% endif %}

    <div class="ai-split-layout__content-wrapper-{{ ai_gen_id }}">
      <div class="ai-split-layout__content-{{ ai_gen_id }}">
        {% if block.settings.show_badge %}
          <div class="ai-split-layout__badge-wrapper-{{ ai_gen_id }}">
            <div class="ai-split-layout__badge-{{ ai_gen_id }}">
              {{ block.settings.badge_text }}
            </div>
          </div>
        {% endif %}

        {% if block.settings.show_rating %}
          <div class="ai-split-layout__rating-{{ ai_gen_id }}">
            {% for i in (1..5) %}
              <svg class="ai-split-layout__star-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            {% endfor %}
          </div>
        {% endif %}

        {% if block.settings.heading != blank %}
          <h2 class="ai-split-layout__heading-{{ ai_gen_id }}">
            {{ block.settings.heading }}
          </h2>
        {% endif %}

        <ul class="ai-split-layout__bullets-{{ ai_gen_id }}">
          {% if block.settings.bullet_1 != blank %}
            <li class="ai-split-layout__bullet-item-{{ ai_gen_id }}">
              <div class="ai-split-layout__checkmark-{{ ai_gen_id }}">
                <svg class="ai-split-layout__checkmark-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <span>{{ block.settings.bullet_1 }}</span>
            </li>
          {% endif %}

          {% if block.settings.bullet_2 != blank %}
            <li class="ai-split-layout__bullet-item-{{ ai_gen_id }}">
              <div class="ai-split-layout__checkmark-{{ ai_gen_id }}">
                <svg class="ai-split-layout__checkmark-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <span>{{ block.settings.bullet_2 }}</span>
            </li>
          {% endif %}

          {% if block.settings.bullet_3 != blank %}
            <li class="ai-split-layout__bullet-item-{{ ai_gen_id }}">
              <div class="ai-split-layout__checkmark-{{ ai_gen_id }}">
                <svg class="ai-split-layout__checkmark-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <span>{{ block.settings.bullet_3 }}</span>
            </li>
          {% endif %}
        </ul>

        {% if block.settings.button_text != blank %}
          <a href="{{ block.settings.button_link }}" class="ai-split-layout__cta-{{ ai_gen_id }}">
            {{ block.settings.button_text }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</div>

