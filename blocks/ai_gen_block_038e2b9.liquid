{% doc %}
  @prompt
    Erstelle eine minimalistische Vergleichstabelle (Comparison Table / VS-Section) auf rein weißem Hintergrund. Ganz oben steht die zentrierte Überschrift ‚Das spricht für uns‘. Darunter folgen drei Spaltenköpfe: links das Logo/Brand-Name ‚MK Beauty Cosmetics‘, in der Mitte ein großes, hellgraues ‚VS‘ und rechts das Wort ‚ANDERE‘. Darunter befinden sich vier Zeilen, die durch feine, horizontale Linien getrennt sind. In jeder Zeile steht mittig das Kriterium (z. B. Hautvorteile), links davon ein hellblaues Häkchen-Symbol (Checkmark) und rechts davon ein schwarzes Kreuz-Symbol (X-Mark). Das gesamte Layout ist sauber zentriert und übersichtlich gestaltet
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-comparison-table-{{ ai_gen_id }} {
    display: block;
    background-color: #ffffff;
    padding: 60px 20px;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-comparison-table__container-{{ ai_gen_id }} {
    max-width: 900px;
    margin: 0 auto;
  }

  .ai-comparison-table__heading-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 40px;
    font-weight: 600;
  }

  .ai-comparison-table__header-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 20px;
    margin-bottom: 30px;
    padding: 0 20px;
  }

  .ai-comparison-table__brand-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.brand_size }}px;
    font-weight: 600;
    color: {{ block.settings.brand_color }};
  }

  .ai-comparison-table__vs-{{ ai_gen_id }} {
    font-size: {{ block.settings.vs_size }}px;
    font-weight: 700;
    color: {{ block.settings.vs_color }};
    text-align: center;
    padding: 0 20px;
  }

  .ai-comparison-table__other-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.other_size }}px;
    font-weight: 600;
    color: {{ block.settings.other_color }};
  }

  .ai-comparison-table__row-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 20px;
    padding: 20px;
    border-top: 1px solid {{ block.settings.border_color }};
  }

  .ai-comparison-table__row-{{ ai_gen_id }}:last-child {
    border-bottom: 1px solid {{ block.settings.border_color }};
  }

  .ai-comparison-table__check-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .ai-comparison-table__check-{{ ai_gen_id }} svg {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    stroke: {{ block.settings.check_color }};
    stroke-width: 3;
    fill: none;
  }

  .ai-comparison-table__criterion-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.criterion_size }}px;
    color: {{ block.settings.criterion_color }};
    font-weight: 500;
  }

  .ai-comparison-table__cross-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .ai-comparison-table__cross-{{ ai_gen_id }} svg {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    stroke: {{ block.settings.cross_color }};
    stroke-width: 3;
    fill: none;
  }

  @media screen and (max-width: 749px) {
    .ai-comparison-table-{{ ai_gen_id }} {
      padding: 40px 15px;
    }

    .ai-comparison-table__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
      margin-bottom: 30px;
    }

    .ai-comparison-table__header-{{ ai_gen_id }} {
      gap: 10px;
      padding: 0 10px;
    }

    .ai-comparison-table__brand-{{ ai_gen_id }} {
      font-size: {{ block.settings.brand_size | times: 0.8 }}px;
    }

    .ai-comparison-table__vs-{{ ai_gen_id }} {
      font-size: {{ block.settings.vs_size | times: 0.8 }}px;
      padding: 0 10px;
    }

    .ai-comparison-table__other-{{ ai_gen_id }} {
      font-size: {{ block.settings.other_size | times: 0.8 }}px;
    }

    .ai-comparison-table__row-{{ ai_gen_id }} {
      gap: 10px;
      padding: 15px 10px;
    }

    .ai-comparison-table__criterion-{{ ai_gen_id }} {
      font-size: {{ block.settings.criterion_size | times: 0.9 }}px;
    }

    .ai-comparison-table__check-{{ ai_gen_id }} svg,
    .ai-comparison-table__cross-{{ ai_gen_id }} svg {
      width: {{ block.settings.icon_size | times: 0.8 }}px;
      height: {{ block.settings.icon_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<comparison-table-{{ ai_gen_id }}
  class="ai-comparison-table-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-comparison-table__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-comparison-table__heading-{{ ai_gen_id }}">
        {{ block.settings.heading }}
      </h2>
    {% endif %}

    <div class="ai-comparison-table__header-{{ ai_gen_id }}">
      <div class="ai-comparison-table__brand-{{ ai_gen_id }}">
        {{ block.settings.brand_name }}
      </div>
      <div class="ai-comparison-table__vs-{{ ai_gen_id }}">VS</div>
      <div class="ai-comparison-table__other-{{ ai_gen_id }}">
        {{ block.settings.other_label }}
      </div>
    </div>

    {% if block.settings.criterion_1 != blank %}
      <div class="ai-comparison-table__row-{{ ai_gen_id }}">
        <div class="ai-comparison-table__check-{{ ai_gen_id }}">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </div>
        <div class="ai-comparison-table__criterion-{{ ai_gen_id }}">
          {{ block.settings.criterion_1 }}
        </div>
        <div class="ai-comparison-table__cross-{{ ai_gen_id }}">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </div>
      </div>
    {% endif %}

    {% if block.settings.criterion_2 != blank %}
      <div class="ai-comparison-table__row-{{ ai_gen_id }}">
        <div class="ai-comparison-table__check-{{ ai_gen_id }}">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </div>
        <div class="ai-comparison-table__criterion-{{ ai_gen_id }}">
          {{ block.settings.criterion_2 }}
        </div>
        <div class="ai-comparison-table__cross-{{ ai_gen_id }}">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </div>
      </div>
    {% endif %}

    {% if block.settings.criterion_3 != blank %}
      <div class="ai-comparison-table__row-{{ ai_gen_id }}">
        <div class="ai-comparison-table__check-{{ ai_gen_id }}">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </div>
        <div class="ai-comparison-table__criterion-{{ ai_gen_id }}">
          {{ block.settings.criterion_3 }}
        </div>
        <div class="ai-comparison-table__cross-{{ ai_gen_id }}">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </div>
      </div>
    {% endif %}

    {% if block.settings.criterion_4 != blank %}
      <div class="ai-comparison-table__row-{{ ai_gen_id }}">
        <div class="ai-comparison-table__check-{{ ai_gen_id }}">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </div>
        <div class="ai-comparison-table__criterion-{{ ai_gen_id }}">
          {{ block.settings.criterion_4 }}
        </div>
        <div class="ai-comparison-table__cross-{{ ai_gen_id }}">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </div>
      </div>
    {% endif %}
  </div>
</comparison-table-{{ ai_gen_id }}>

<script>
  (function() {
    class ComparisonTable{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('comparison-table-{{ ai_gen_id }}', ComparisonTable{{ ai_gen_id }});
  })();
</script>

