{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-category-grid-{{ ai_gen_id }} {
    width: 100%;
    display: block;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-category-grid__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 {{ block.settings.container_padding }}px;
  }

  .ai-category-grid__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.tile_gap }}px;
  }

  .ai-category-grid__tile-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.tile_border_radius }}px;
    aspect-ratio: {{ block.settings.tile_aspect_ratio }};
  }

  .ai-category-grid__link-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: 100%;
    height: 100%;
    text-decoration: none;
  }

  .ai-category-grid__image-wrapper-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .ai-category-grid__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .ai-category-grid__link-{{ ai_gen_id }}:hover .ai-category-grid__image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-category-grid__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-category-grid__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-category-grid__content-wrapper-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 2;
    pointer-events: none;
    width: 100%;
    transition: transform 0.35s ease-in-out;
  }

  .ai-category-grid__link-{{ ai_gen_id }}:hover .ai-category-grid__content-wrapper-{{ ai_gen_id }} {
    transform: translate(-50%, -65%);
  }

  .ai-category-grid__title-{{ ai_gen_id }} {
    font-family: {{ block.settings.title_font.family }}, {{ block.settings.title_font.fallback_families }};
    font-weight: {{ block.settings.title_font.weight }};
    font-style: {{ block.settings.title_font.style }};
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    text-align: center;
    margin: 0;
    padding: 0 20px;
    line-height: 1.2;
    letter-spacing: {{ block.settings.title_letter_spacing }}px;
  }

  .ai-category-grid__button-{{ ai_gen_id }} {
    width: {{ block.settings.button_size }}px;
    height: {{ block.settings.button_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.button_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 12px;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.35s ease-in-out, transform 0.35s ease-in-out;
  }

  .ai-category-grid__link-{{ ai_gen_id }}:hover .ai-category-grid__button-{{ ai_gen_id }} {
    opacity: 1;
    transform: translateY(0);
  }

  .ai-category-grid__button-{{ ai_gen_id }} svg {
    width: {{ block.settings.arrow_size }}px;
    height: {{ block.settings.arrow_size }}px;
    stroke: {{ block.settings.button_arrow_color }};
    stroke-width: 2;
    fill: none;
  }

  @media screen and (max-width: 989px) {
    .ai-category-grid__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }

    .ai-category-grid__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-category-grid__button-{{ ai_gen_id }} {
      width: {{ block.settings.button_size | times: 0.8 }}px;
      height: {{ block.settings.button_size | times: 0.8 }}px;
    }

    .ai-category-grid__button-{{ ai_gen_id }} svg {
      width: {{ block.settings.arrow_size | times: 0.8 }}px;
      height: {{ block.settings.arrow_size | times: 0.8 }}px;
    }

    .ai-category-grid__link-{{ ai_gen_id }}:hover .ai-category-grid__content-wrapper-{{ ai_gen_id }} {
      transform: translate(-50%, -60%);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-category-grid__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-category-grid__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.7 }}px;
    }

    .ai-category-grid__button-{{ ai_gen_id }} {
      width: {{ block.settings.button_size | times: 0.7 }}px;
      height: {{ block.settings.button_size | times: 0.7 }}px;
    }

    .ai-category-grid__button-{{ ai_gen_id }} svg {
      width: {{ block.settings.arrow_size | times: 0.7 }}px;
      height: {{ block.settings.arrow_size | times: 0.7 }}px;
    }

    .ai-category-grid__link-{{ ai_gen_id }}:hover .ai-category-grid__content-wrapper-{{ ai_gen_id }} {
      transform: translate(-50%, -58%);
    }
  }
{% endstyle %}

<category-grid-{{ ai_gen_id }} class="ai-category-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-category-grid__container-{{ ai_gen_id }}">
    <div class="ai-category-grid__grid-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign tile_image_key = 'tile_' | append: i | append: '_image'
          assign tile_title_key = 'tile_' | append: i | append: '_title'
          assign tile_collection_key = 'tile_' | append: i | append: '_collection'

          assign tile_image = block.settings[tile_image_key]
          assign tile_title = block.settings[tile_title_key]
          assign tile_collection = block.settings[tile_collection_key]
        %}

        <div class="ai-category-grid__tile-{{ ai_gen_id }}">
          {% if tile_collection != blank %}
            <a href="{{ tile_collection.url }}" class="ai-category-grid__link-{{ ai_gen_id }}">
          {% else %}
            <div class="ai-category-grid__link-{{ ai_gen_id }}">
          {% endif %}

            <div class="ai-category-grid__image-wrapper-{{ ai_gen_id }}">
              {% if tile_image %}
                <img
                  src="{{ tile_image | image_url: width: 800 }}"
                  alt="{{ tile_image.alt | escape }}"
                  loading="lazy"
                  width="{{ tile_image.width }}"
                  height="{{ tile_image.height }}"
                  class="ai-category-grid__image-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="ai-category-grid__image-placeholder-{{ ai_gen_id }}">
                  {{ 'collection-apparel-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            {% if tile_title != blank %}
              <div class="ai-category-grid__content-wrapper-{{ ai_gen_id }}">
                <h3 class="ai-category-grid__title-{{ ai_gen_id }}">{{ tile_title }}</h3>
                <div class="ai-category-grid__button-{{ ai_gen_id }}">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </div>
              </div>
            {% endif %}

          {% if tile_collection != blank %}
            </a>
          {% else %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</category-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class CategoryGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('category-grid-{{ ai_gen_id }}', CategoryGrid{{ ai_gen_id }});
  })();
</script>

