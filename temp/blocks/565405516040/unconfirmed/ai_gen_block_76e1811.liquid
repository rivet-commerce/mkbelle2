{% doc %}
  @prompt
    baue eine section in der ich meine deinstleitsugen gut darstellen kann 
    
    das sind meine haupt diensleitung bze die überschirtfen mit eintelnen behandlungen 
    
    Dauerhafte Haarentfernung
    Mit modernem Diodenlaser 808pro
    
    Microneedling
    Behandlungen für Narben & Hautverbesserung
    
    Gesichtsbehandlungen
    Facials für jeden Hauttyp
    
    Make-up & Styling
    Professionelle Make-up Services
    
    Permanent Make-up
    Langfristige Schönheitsbehandlungen
    
    Wimpern & Augenbrauen
    Styling & Pflege für Wimpern und Brauen
    
    Wimpernverlängerung
    Verschiedene Techniken für natürliche Wimpern
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-services-section-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-services-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-services-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.header_alignment }};
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-services-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_margin }}px;
    font-weight: 600;
  }

  .ai-services-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
    line-height: 1.6;
  }

  .ai-services-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin-top: {{ block.settings.grid_margin_top }}px;
  }

  .ai-service-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .ai-service-card-{{ ai_gen_id }}:hover {
    transform: translateY(-{{ block.settings.card_hover_lift }}px);
    box-shadow: 0 {{ block.settings.card_hover_lift | times: 2 }}px {{ block.settings.card_hover_lift | times: 4 }}px rgba(0, 0, 0, 0.1);
  }

  .ai-service-icon-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    background-color: {{ block.settings.icon_background }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: {{ block.settings.icon_margin }}px;
  }

  .ai-service-icon-{{ ai_gen_id }} {
    width: calc({{ block.settings.icon_size }}px * 0.5);
    height: calc({{ block.settings.icon_size }}px * 0.5);
    color: {{ block.settings.icon_color }};
  }

  .ai-service-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.service_title_size }}px;
    color: {{ block.settings.service_title_color }};
    margin: 0 0 {{ block.settings.service_title_margin }}px;
    font-weight: 600;
  }

  .ai-service-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.service_description_size }}px;
    color: {{ block.settings.service_description_color }};
    margin: 0;
    line-height: 1.6;
    flex-grow: 1;
  }

  @media screen and (max-width: 989px) {
    .ai-services-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }

    .ai-services-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-service-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.service_title_size }}px * 0.9);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-services-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-services-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.6 }}px 16px {{ block.settings.section_padding_bottom | times: 0.6 }}px;
    }

    .ai-services-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.7);
    }

    .ai-service-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.service_title_size }}px * 0.85);
    }

    .ai-service-card-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-services-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
