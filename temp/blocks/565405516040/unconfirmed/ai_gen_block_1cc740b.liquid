{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-services-grid-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-services-grid__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-services-grid__heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    color: {{ block.settings.heading_color }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-services-grid__items-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-services-grid__item-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    text-decoration: none;
    display: block;
    color: inherit;
  }

  .ai-services-grid__item-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
  }

  .ai-services-grid__icon-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin: 0 auto {{ block.settings.icon_spacing }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.icon_background }};
    border-radius: 50%;
  }

  .ai-services-grid__icon-wrapper-{{ ai_gen_id }} img {
    width: calc({{ block.settings.icon_size }}px * 0.6);
    height: calc({{ block.settings.icon_size }}px * 0.6);
    object-fit: contain;
  }

  .ai-services-grid__icon-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-services-grid__icon-placeholder-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.icon_size }}px * 0.6);
    height: calc({{ block.settings.icon_size }}px * 0.6);
    color: {{ block.settings.icon_color }};
  }

  .ai-services-grid__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin-bottom: {{ block.settings.title_spacing }}px;
    font-weight: 600;
  }

  .ai-services-grid__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-services-grid__items-{{ ai_gen_id }} {
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: {{ block.settings.grid_gap | times: 0.7 }}px;
    }

    .ai-services-grid__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }
  }
{% endstyle %}

<div class="ai-services-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-services-grid__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-services-grid__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-services-grid__items-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign service_enabled_key = 'service_' | append: i | append: '_enabled'
          assign service_title_key = 'service_' | append: i | append: '_title'
          assign service_description_key = 'service_' | append: i | append: '_description'
          assign service_icon_key = 'service_' | append: i | append: '_icon'
          assign service_link_key = 'service_' | append: i | append: '_link'

          assign service_enabled = block.settings[service_enabled_key]
          assign service_title = block.settings[service_title_key]
          assign service_description = block.settings[service_description_key]
          assign service_icon = block.settings[service_icon_key]
          assign service_link = block.settings[service_link_key]
        %}

        {% if service_enabled %}
          {% if service_link != blank %}
            <a href="{{ service_link }}" class="ai-services-grid__item-{{ ai_gen_id }}">
          {% else %}
            <div class="ai-services-grid__item-{{ ai_gen_id }}">
          {% endif %}

            <div class="ai-services-grid__icon-wrapper-{{ ai_gen_id }}">
              {% if service_icon %}
                <img
                  src="{{ service_icon | image_url: width: 200 }}"
                  alt="{{ service_title | escape }}"
                  loading="lazy"
                  width="200"
                  height="200"
                >
              {% else %}
                <div class="ai-services-grid__icon-placeholder-{{ ai_gen_id }}">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                  </svg>
                </div>
              {% endif %}
            </div>

            {% if service_title != blank %}
              <h3 class="ai-services-grid__title-{{ ai_gen_id }}">{{ service_title }}</h3>
            {% endif %}

            {% if service_description != blank %}
              <div class="ai-services-grid__description-{{ ai_gen_id }}">{{ service_description }}</div>
            {% endif %}

          {% if service_link != blank %}
            </a>
          {% else %}
            </div>
          {% endif %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

