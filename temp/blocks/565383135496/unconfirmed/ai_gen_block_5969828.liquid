                <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/>
              </svg>
          {% endcase %}
        </div>
        <div class="ai-benefit-bar-text-{{ ai_gen_id }}">
          <h3 class="ai-benefit-bar-title-{{ ai_gen_id }}">{{ block.settings.benefit_1_title }}</h3>
          {% if block.settings.benefit_1_subtitle != blank %}
