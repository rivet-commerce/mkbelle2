                <path d="M3 6c0-1.5 1-3 2.5-3.5S8 1 9.5 1s3 1 4.5 1.5 3 1 4.5 1.5S21 6 21 7.5 20 10.5 18.5 11 16 12 14.5 12s-3-1-4.5-1.5-3-1-4.5-1.5S3 7.5 3 6z"/>
                <path d="M3 18c0-1.5 1-3 2.5-3.5S8 13 9.5 13s3 1 4.5 1.5 3 1 4.5 1.5 2.5 2 2.5 3.5-1 3-2.5 3.5S16 24 14.5 24s-3-1-4.5-1.5-3-1-4.5-1.5S3 19.5 3 18z"/>
              </svg>
            {% when 'sun' %}
