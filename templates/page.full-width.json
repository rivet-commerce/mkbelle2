        "8672deb1-2a68-4ab0-ab7f-9395162277cb": {
          "type": "text",
          "settings": {
            "enlarge_text": true,
            "text": "<p><strong>Unsere Dienstleistungen für Sie:</strong><br/>Permanent Make-up ||| Brows & Lashes ||| Make-up Styling ||| Akne Behandlung<br/>Facial Care ||| Laser-Haarentfernung ||| Kosm. Zahnbleaching ||| Men‘s Care und Schulungen</p>"
