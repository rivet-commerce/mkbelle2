    "17838599081e6f351e": {
      "type": "_blocks",
      "blocks": {
        "ai_gen_block_c1cc1a4_qbr3EQ": {
          "type": "ai_gen_block_c1cc1a4",
          "settings": {
            "profile_image": "shopify://shop_images/WhatsApp_Image_2026-08-02_at_17.07.49.jpg",
            "profile_size": 60,
            "title": "Monique's Routine",
            "subtitle": "Meine tägliche Hautpflege-Routine",
            "step_1_title": "HANF SOAP FACE WASH",
            "step_1_description": "Morgens starte ich meinen Tag mit unserer Hanfseife. Sie reinigt meine Haut besonders sanft, entfernt überschüssigen Talg und hinterlässt ein wunderbar frisches Hautgefühl. Ich liebe dieses saubere Gefühl am Morgen.",
            "step_1_product": "hanf-soap-face-wash",
            "step_2_title": "Hydro Save Creme",
            "step_2_description": "Direkt danach trage ich meine Hydro Safe Creme auf. Sie spendet intensive Feuchtigkeit und stärkt die Hautbarriere. Denn auch fettige Haut braucht Feuchtigkeit – fehlt sie, produziert die Haut oft noch mehr Talg. Eine gesunde Hautbarriere ist die Grundlage für einen frischen, strahlenden Teint.",
            "step_2_product": "hydro-save-creme",
            "step_3_title": "Lotos Sensation Tonic",
            "step_3_description": "Wenn ich unterwegs bin oder meiner Haut zwischendurch etwas Frische gönnen möchte, verwende ich mein Lotus Sensation Tonic. Es spendet sofort Feuchtigkeit und belebt die Haut. Bei Bedarf trage ich anschließend noch etwas Hydro Safe Creme auf – und meine Haut fühlt sich wieder frisch gepflegt an.",
            "step_3_product": "lotos-sensation-tonic",
            "step_4_title": "Bamboo Scrub",
            "step_4_description": "Abends steht die Regeneration im Fokus. Zwei- bis dreimal pro Woche verwende ich den Bamboo Scrub. Das sanfte Peeling entfernt abgestorbene Hautschüppchen und sorgt für ein glattes, ebenmäßiges Hautbild.",
            "step_4_product": "bamboo-scrub",
            "step_5_title": "Hyaluron Facial Mask",
            "step_5_description": "Danach gönne ich meiner Haut eine Extraportion Pflege mit der Hyaluron Face Mask. Über Nacht versorgt sie die Haut intensiv mit Feuchtigkeit und unterstützt ihre Regeneration. Am Morgen wirkt die Haut frisch, erholt und strahlend.",
            "step_5_product": "hyaluron-facialmask-25ml-25-stuck",
            "step_6_title": "Skin Balance Tonic",
            "step_6_description": "Natürlich gibt es Momente, in denen äußere Faktoren oder hormonelle Schwankungen meine Haut belasten und sie unruhig wirken lassen. Genau in diesen Situationen verlasse ich mich auf das Skin Balance Tonic. Es wirkt angenehm beruhigend, klärt die Haut tiefenwirksam und beugt gezielt der Entstehung von Unreinheiten vor.",
            "step_6_product": "skin-balance-tonic",
