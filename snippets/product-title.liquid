{%- if isModal -%}
  <p class="h2 product-single__title" style="margin-bottom: 0px !important; margin-top: 15px !important;">
    {{ product.title }}
  </p>
{%- else -%}
  <{{ block.settings.heading_tag }} class="h2 product-single__title" style="margin-bottom: 0px !important; margin-top: 5px !important;">
    {%- unless product.empty? -%}
      {{ product.title }}
    {%- else -%}
      {{ 'home_page.onboarding.product_title' | t }}
    {%- endunless -%}
  </{{ block.settings.heading_tag }}>
{%- endif -%}